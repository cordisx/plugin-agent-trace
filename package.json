{
  "name": "@cordisx/agent-trace-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only CordisX Agent Trace Timeline plugin",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-Hans.md",
    "cordisx.plugin.json",
    "runtime-manifest.json",
    "legal"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "naming:check": "node scripts/check-public-naming.mjs",
    "check": "npm run naming:check && npm run typecheck && npm run build && npm test && npm run naming:check && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "cordisx": "0.1.0-beta.1"
  },
  "devDependencies": {
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#3e3f248abb94fe57e613b020ffa8a6ceaba6c3cd",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19"
  }
}
